# ==============================================================================
# SEETHAPAATI MONOREPO — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Template only. Replace every example/placeholder with business- and host-specific values before deployment.
#
# FOR BACKEND DEPLOYMENTS (Render, Railway, AWS, DigitalOcean):
# Configure these variables in your backend service environment settings (or apps/api/.env)
#
# FOR FRONTEND DEPLOYMENTS (Vercel, Cloudflare Pages, Netlify):
# Configure these variables in your frontend project settings (or apps/web/.env.production)
# ==============================================================================

# ==============================================================================
# BACKEND API (apps/api/.env)
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=4000

# Docker Compose PostgreSQL credentials (required by docker-compose.prod.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="seethapaati_prod"

# Docker Compose DATABASE_URL uses the service hostname "postgres".
# When running the API directly on your host, change "postgres" to "localhost".
# URL-encode any reserved characters in the password.
DATABASE_URL="postgresql://postgres:URL_ENCODED_DB_PASSWORD@postgres:5432/seethapaati_prod?schema=public"

# Redis Cache & Queues
# Docker Compose uses REDIS_HOST/PORT/PASSWORD:
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""

# For a managed Redis provider instead, set REDIS_URL (rediss:// for TLS)
# and configure REDIS_HOST/PORT/PASSWORD from that provider.

# Security (Generate a 32+ character key: openssl rand -base64 32)
JWT_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin (Set to your live frontend URL; comma-separated for multiple)
CORS_ORIGIN="https://store.example.test"

# Razorpay Payment Gateway (Live credentials from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Email Delivery (Resend API Key from https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="orders@example.test"

# Statutory Seller Configuration for Invoicing & GST Compliance
SELLER_LEGAL_NAME="REPLACE_WITH_ACTUAL_REGISTERED_LEGAL_NAME"
SELLER_TRADE_NAME="REPLACE_WITH_ACTUAL_TRADE_NAME"
# Placeholder only — replace with the actual registered GSTIN before production.
SELLER_GSTIN="33AAAAA0000A1Z5"
SELLER_ADDRESS_LINE1="REPLACE_WITH_REGISTERED_ADDRESS"
SELLER_ADDRESS_LINE2=""
SELLER_CITY="REPLACE_WITH_REGISTERED_CITY"
SELLER_STATE="REPLACE_WITH_REGISTERED_STATE"
SELLER_STATE_CODE="00"
SELLER_PINCODE="000000"

# Inventory Reservation TTL & Auth Rate Limiting
RESERVATION_TTL_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Initial Admin Password (Used during initial seed: npm run db:seed)
ADMIN_INITIAL_PASSWORD=""


# ==============================================================================
# FRONTEND WEB (apps/web/.env.production)
# ==============================================================================

# Browser-facing API endpoint (must end in /api/v1)
NEXT_PUBLIC_API_URL="https://api.example.test/api/v1"
# Server-side API routing and uploads for Docker Compose are configured in docker-compose.prod.yml.
INTERNAL_API_URL="http://api:3001/api/v1"
UPLOAD_DIR="/app/apps/web/public/uploads"
UPLOAD_ALLOWED_ORIGINS="https://store.example.test"

# Storefront Brand Identity
NEXT_PUBLIC_STORE_NAME="SEETHAPAATI"
NEXT_PUBLIC_SITE_URL="https://store.example.test"
# Public business disclosures (must match the actual registered business and API SELLER_* values).
# These are public build-time values; never put secrets here.
NEXT_PUBLIC_LEGAL_ENTITY_NAME="REPLACE_WITH_ACTUAL_REGISTERED_LEGAL_NAME"
NEXT_PUBLIC_BUSINESS_REGISTRATION_LABEL=""
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=""
NEXT_PUBLIC_FSSAI_LICENSE_NUMBER="00000000000000"
NEXT_PUBLIC_REGISTERED_OFFICE="REPLACE_WITH_REGISTERED_OFFICE_ADDRESS"
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME="REPLACE_WITH_DESIGNATED_GRIEVANCE_OFFICER"
NEXT_PUBLIC_GRIEVANCE_EMAIL="grievance@example.test"
NEXT_PUBLIC_PRIVACY_EMAIL="privacy@example.test"
NEXT_PUBLIC_LEGAL_EMAIL="legal@example.test"
NEXT_PUBLIC_SUPPORT_EMAIL="care@example.test"
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY="REPLACE_WITH_VERIFIED_SUPPORT_PHONE"
NEXT_PUBLIC_SUPPORT_PHONE_E164="+910000000000"
NEXT_PUBLIC_WHATSAPP_PHONE="910000000000"

# Public Razorpay Key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Google Search Console Verification (Optional: paste verification code here)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Analytics Toggle
NEXT_PUBLIC_ENABLE_ANALYTICS=false
